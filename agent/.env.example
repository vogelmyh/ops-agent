# Default: fully offline (no API keys, no backend, no Docker)
BACKEND_MODE=mock
BACKEND_BASE_URL=http://localhost:8081
LLM_MODE=mock
# Real LLM + simulator: BACKEND_MODE=real LLM_MODE=real EMBEDDINGS_PROVIDER=qwen
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-v4-flash
OPENAI_MODEL_STRONG=deepseek-v4-pro
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# OPENAI_BASE_URL=https://ws-qnb511hekghayqvl.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# OPENAI_MODEL=qwen3.6-flash
# OPENAI_MODEL_STRONG=qwen3.7-plus
QWEN_API_KEY=
# QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_BASE_URL=https://ws-qnb511hekghayqvl.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
EMBEDDINGS_PROVIDER=local-hash
EMBEDDINGS_MODEL=text-embedding-v3
CHECKPOINTER=sqlite
CHECKPOINTER_SQLITE_PATH=./data/checkpoints.db
REDIS_URL=redis://localhost:6379/0
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ops-agent
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000
