# Default: fully offline (no API keys, no backend, no Docker)
BACKEND_MODE=mock
BACKEND_BASE_URL=http://localhost:8080
LLM_MODE=mock

# Chat / structured-output LLM (OpenAI-compatible). Recommended: DeepSeek V4.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-v4-flash
OPENAI_MODEL_STRONG=deepseek-v4-pro

# Embedding provider: local-hash (mock) | openai | qwen (Aliyun DashScope)
# Chat and embedding may use different vendors (e.g. DeepSeek chat + Qwen embeddings).
EMBEDDINGS_PROVIDER=local-hash
EMBEDDINGS_MODEL=text-embedding-v3

# Aliyun DashScope embedding (EMBEDDINGS_PROVIDER=qwen)
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

CHECKPOINTER=sqlite
CHECKPOINTER_SQLITE_PATH=./data/checkpoints.db
REDIS_URL=redis://localhost:6379/0
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ops-agent
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000
